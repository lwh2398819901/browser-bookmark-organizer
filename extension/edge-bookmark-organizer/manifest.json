{
  "manifest_version": 3,
  "name": "收藏夹整理助手（本地）",
  "version": "2.0.8",
  "description": "通过本地 Agent 桥接完成收藏、防重复、备份恢复和可撤销的收藏夹整理。",
  "key": "",
  "permissions": ["bookmarks", "downloads", "activeTab", "storage"],
  "background": {
    "service_worker": "bridge.js"
  },
  "externally_connectable": {
    "matches": ["http://127.0.0.1/*", "http://localhost/*"]
  },
  "action": {
    "default_title": "收藏夹整理助手",
    "default_popup": "popup.html"
  }
}
